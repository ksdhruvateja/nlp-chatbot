{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MediaBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/media/*"
    },
    {
      "Sid": "MediaKms",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:REPLACE_REGION:REPLACE_ACCOUNT:key/REPLACE_KMS_KEY_ID"
    }
  ]
}
