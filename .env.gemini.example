# Copy to .env.gemini (ignored). Never commit or share populated values.
FIXBRIDGE_GEMINI_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Choose a strong URL-safe password and put the same password in DATABASE_URL.
FIXBRIDGE_DB_PASSWORD=
DATABASE_URL=postgresql://fixbridge:REPLACE_PASSWORD@db:5432/fixbridge?sslmode=disable
FIXBRIDGE_SECRET=
# Generate a Fernet key using cryptography.fernet.Fernet.generate_key().
MEDIA_ENCRYPTION_KEY=
FIXBRIDGE_PORT=8002
# Only enable dev login for a private local trial; never on fixbridge.us.
DEV_AUTH=false
