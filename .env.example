# --- Database (PostgreSQL 16 + pgvector) ---
# Neon: use the POOLED connection string for the app (host contains "-pooler") ...
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/fixbridge?sslmode=require
# ... and the DIRECT one for schema migrations.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/fixbridge?sslmode=require

# --- Security ---
# Secret used to sign API tokens (change in production!)
FIXBRIDGE_SECRET=change-me
# 32-byte urlsafe base64 Fernet key for encrypting media at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDIA_ENCRYPTION_KEY=
# Media storage: local (dev only) | s3 (AWS; required when running more than one container)
STORAGE_BACKEND=local
MEDIA_ROOT=./data/media
S3_BUCKET=
S3_PREFIX=media
S3_KMS_KEY_ID=
AWS_REGION=us-east-2
MAX_UPLOAD_MB=50

# --- AI routing ---
# Cloud provider: gemini | openai | demo | none
CLOUD_PROVIDER=gemini
CLOUD_ENABLED=true
# Also accepted: OPENAI_KEY / GOOGLE_API_KEY / GEMINI_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Preferred name for securely injected Gemini credentials:
FIXBRIDGE_GEMINI_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
TRANSCRIBE_AUDIO=true
CLOUD_TIMEOUT_S=45
CLOUD_RETRIES=2

# Local provider (Ollama-compatible). Set LOCAL_ENABLED=false if no local model is deployed.
LOCAL_ENABLED=false
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:8b
LOCAL_TIMEOUT_S=120

# Embeddings: hash (offline, deterministic) | openai | gemini
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384

# --- Pipeline ---
MAX_CLARIFICATION_ROUNDS=3
MIN_EVIDENCE_PASSAGES=1
MIN_CONFIDENCE=0.55
RUN_WORKER_IN_PROCESS=true

# --- Live prices (Google Shopping via SerpAPI), used when the catalog has no fresh price
PRICE_LOOKUP_PROVIDER=serpapi
SERPAPI_API_KEY=
PRICE_COUNTRY=us

# --- Manual crawler
CRAWLER_CONTACT=admin@fixbridge.us

# Optional reverse-proxy mount prefix, without trailing slash.
ROOT_PATH=
# Standalone local development only. Keep false on fixbridge.us.
DEV_AUTH=false
